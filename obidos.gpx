" lon="-9.15507"></trkpt><trkpt lat="38.52027" lon="-9.15546"></trkpt><trkpt lat="38.5207" lon="-9.15648"></trkpt><trkpt lat="38.52067" lon="-9.15759"></trkpt><trkpt lat="38.52085" lon="-9.15752"></trkpt><trkpt lat="38.52085" lon="-9.15811"></trkpt><trkpt lat="38.52041" lon="-9.15843"></trkpt><trkpt lat="38.51924" lon="-9.15848"></trkpt><trkpt lat="38.5186" lon="-9.15929"></trkpt><trkpt lat="38.51655" lon="-9.16104"></trkpt><trkpt lat="38.51612" lon="-9.16183"></trkpt><trkpt lat="38.5159" lon="-9.16291"></trkpt><trkpt lat="38.51604" lon="-9.16415"></trkpt><trkpt lat="38.51643" lon="-9.16515"></trkpt><trkpt lat="38.51635" lon="-9.16576"></trkpt><trkpt lat="38.51506" lon="-9.16669"></trkpt><trkpt lat="38.51365" lon="-9.16734"></trkpt><trkpt lat="38.51274" lon="-9.16834"></trkpt><trkpt lat="38.51252" lon="-9.1701"></trkpt><trkpt lat="38.51133" lon="-9.1712"></trkpt><trkpt lat="38.50959" lon="-9.17362"></trkpt><trkpt lat="38.50906" lon="-9.17573"></trkpt><trkpt lat="38.51039" lon="-9.17618"></trkpt><trkpt lat="38.51145" lon="-9.17599"></trkpt><trkpt lat="38.51319" lon="-9.17522"></trkpt><trkpt lat="38.51339" lon="-9.17533"></trkpt><trkpt lat="38.51339" lon="-9.17533"></trkpt></trkseg>
